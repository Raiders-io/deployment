URL=here-username.here-domain.here-country-code
OPENSSL_SUBJ=/C=here_country_code/ST=here_state/L=here_locality/O=here_organisation/OU=here_organisation_unit/CN=here_common_name

PORT=3000
AUTH_SERVICE_URL=http://auth-service:3333
MESSAGING_SERVICE_URL=http://messaging-service:3333
USER_SERVICE_URL=http://user-service:3333
GRAFANA_PORT=9000
GF_SERVER_ROOT_URL=https://localhost:4443/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true
GF_SERVER_HTTP_PORT=${GRAFANA_PORT}
PROMETHEUS_PORT=9090
