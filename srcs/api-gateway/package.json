{
  "name": "api-gateway",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch config --ext ts,json --exec ts-node src/index.ts",
    "build": "tsc",
    "start-trace": "node --trace-deprecation dist/index.js",
    "start": "node --trace-deprecation dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.0.1",
    "express-rate-limit": "^8.6.2",
    "express-slow-down": "^3.1.0",
    "http-proxy-middleware": "^4.2.0",
    "i": "^0.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "jiti": "^2.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
