{
  "proxy": [
    {
      "name": "messaging",
      "target": "http://messaging-api:3334",
      "routes": ["/api/socket.io", "/api/messaging"],
      "websocket": true
    },
    {
      "name": "object",
      "target": "http://object-api:3333",
      "routes": ["/api/v1/storage"]
    },
    {
      "name": "auth",
      "target": "http://auth-service:3333",
      "routes": ["/api/v1/auth", "/api/v1/account"]
    },
    {
      "name": "user",
      "target": "http://user-service:3333",
      "routes": ["/api/v1/profile", "/api/v1/friends"]
    },
    {
      "name": "lesson",
      "target": "http://lesson-api:3333",
      "routes": ["/api/v1/lessons", "/api/v1/search"]
    },
    {
      "name": "exam",
      "target": "http://exam_api:3333",
      "routes": ["/api/v1/questions", "/api/v1/exam-authorings", "/api/v1/exam-papers"]
    }
  ],
  "logger": false,
  "slowdown": {
    "windowMs": 30000,
    "delayAfter": 10,
    "delayMs": 200,
    "maxDelayMs": 500000
  },
  "rateLimit": {
    "windowMs": 3000,
    "limit": 10,
    "message": "Too many requests from this IP, please try again after 5 minutes"
  }
}
